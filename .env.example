# Gatherly AI - Environment Configuration Example
# Copy this file to .env.local to configure live Gemini AI features.
# If no key is provided, Gatherly AI runs seamlessly in Deterministic Demo Mode.

# Google Gemini API Key (get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
