# Gatherly AI - Environment Configuration Example
# Copy this file to .env.local to configure live Gemini AI features.
# If no key is provided, Gatherly AI runs seamlessly in Deterministic Demo Mode.

# Google Gemini API Key (get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server-Side Rate Limiting (Requests per client per minute)
RATE_LIMIT_GENERATE_MAX=5
RATE_LIMIT_GENERATE_WINDOW=60
RATE_LIMIT_REFINE_MAX=10
RATE_LIMIT_REFINE_WINDOW=60

# MANDATORY IN PRODUCTION FOR LIVE AI: Distributed Rate Limiting (Upstash Redis)
# In production with live Gemini AI enabled, Upstash Redis configuration is MANDATORY.
# Silent in-memory fallback is strictly prohibited in production to prevent distributed
# quota exhaustion across serverless or containerized instances.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Security Behavior: Fail-closed on storage backend failure
RATE_LIMIT_FAIL_CLOSED=true
